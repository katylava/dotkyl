#!/usr/bin/env zsh
# Claude Code status line
# Reads JSON from stdin, outputs a styled status line.

input=$(cat)

# ── Parse JSON fields ────────────────────────────────────────────────────────

model_id=$(echo "$input" | jq -r '.model.id // "claude"')
model_name=$(echo "$input" | jq -r '.model.display_name // "Claude"')
cwd=$(echo "$input" | jq -r '.workspace.current_dir // .cwd // ""')
used_pct=$(echo "$input" | jq -r '.context_window.used_percentage // empty')
cost_usd=$(echo "$input" | jq -r '.cost.total_cost_usd // 0')
vim_mode=$(echo "$input" | jq -r '.vim.mode // empty')

# ── ANSI helpers ─────────────────────────────────────────────────────────────

reset='\033[0m'

# Foreground colours (256-colour)
fg_cyan='\033[38;5;80m'       # bright cyan  — matches starship "frame"
fg_dim='\033[38;5;240m'       # dark grey    — matches starship "separator"
fg_green='\033[38;5;114m'     # soft green   — matches starship "lang"
fg_purple='\033[38;5;141m'    # soft purple  — matches starship "ctx"
fg_yellow='\033[38;5;221m'    # warm yellow  — matches starship "alert"
fg_red='\033[38;5;203m'       # soft red     — matches starship "err"
fg_white='\033[38;5;252m'     # near-white
fg_blue='\033[38;5;111m'      # soft blue    — matches starship "note"
fg_black='\033[38;5;235m'     # near-black (for text on bright bg)
bold='\033[1m'
dim='\033[2m'

# ── Model icon & short name ───────────────────────────────────────────────────

case "$model_name" in
    *Sonnet*) model_icon="󰫎 " ; model_colour="$fg_cyan"  ;;
    *Haiku*)  model_icon="󱩖 " ; model_colour="$fg_blue"  ;;
    *Opus*)   model_icon="󰮣 " ; model_colour="$fg_purple" ;;
    *)        model_icon=" "  ; model_colour="$fg_white" ;;
esac

# Strip "claude-" prefix from model ID for brevity
model_short="${model_id#claude-}"

# ── Context bar ───────────────────────────────────────────────────────────────
# 10-cell filled/empty block bar

context_bar=""
context_colour="$fg_green"
if [[ -n "$used_pct" ]]; then
    used_int=$(printf '%.0f' "$used_pct")
    filled=$(( used_int * 10 / 100 ))
    empty=$(( 10 - filled ))

    # Colour shifts as context fills up
    if   (( used_int >= 80 )); then context_colour="$fg_red"
    elif (( used_int >= 60 )); then context_colour="$fg_yellow"
    else                            context_colour="$fg_green"
    fi

    for (( i=0; i<filled; i++ )); do context_bar+="█"; done
    for (( i=0; i<empty;  i++ )); do context_bar+="░"; done

    context_label="${used_int}%%"
else
    context_bar="░░░░░░░░░░"
    context_label="—"
fi

# ── Cost (from API) ──────────────────────────────────────────────────────────

cost=$(printf '%.3f' "$cost_usd")

# ── Spend limit (undocumented /api/oauth/usage endpoint) ─────────────────────
# Renders nothing unless the account has a spend limit configured. Decoration
# only, not load-bearing: the endpoint can change or vanish on any CLI update.

_usage_cache="$HOME/.cache/claude-statusline-usage.json"
_usage_ttl=300  # 5 minutes

_usage_mtime=$(stat -f %m "$_usage_cache" 2>/dev/null)
if (( $(date +%s) - ${_usage_mtime:-0} > _usage_ttl )); then
    (
        _usage_token=$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null \
            | jq -r '.claudeAiOauth.accessToken // empty' 2>/dev/null)
        [[ -n "$_usage_token" ]] && curl -sf --max-time 10 \
            -H "Authorization: Bearer $_usage_token" \
            -H "Content-Type: application/json" \
            -H "anthropic-beta: oauth-2025-04-20" \
            https://api.anthropic.com/api/oauth/usage > "${_usage_cache}.tmp" 2>/dev/null \
            && mv "${_usage_cache}.tmp" "$_usage_cache"
    ) &!
fi

seg_usage=""
_usage_enabled=$(jq -r 'if .spend.enabled then "1" else "" end' "$_usage_cache" 2>/dev/null)
_usage_limit=$(jq -r '.spend.limit.amount_minor // empty' "$_usage_cache" 2>/dev/null)

if [[ -n "$_usage_enabled" && -n "$_usage_limit" && "$_usage_limit" != "null" ]]; then
    _usage_used=$(jq -r '.spend.used.amount_minor // 0' "$_usage_cache")
    _usage_exp=$(jq -r '.spend.used.exponent // 2' "$_usage_cache")
    _usage_pct=$(jq -r '.spend.percent // 0' "$_usage_cache")
    _usage_pct_int=$(printf '%.0f' "$_usage_pct")
    _usage_divisor=$(( 10 ** _usage_exp ))
    _usage_used_fmt=$(awk -v u="$_usage_used" -v d="$_usage_divisor" 'BEGIN { printf "%.2f", u / d }')
    _usage_limit_fmt=$(awk -v l="$_usage_limit" -v d="$_usage_divisor" 'BEGIN { printf "%.0f", l / d }')

    if   (( _usage_pct_int >= 90 )); then _usage_colour="$fg_red"
    elif (( _usage_pct_int >= 70 )); then _usage_colour="$fg_yellow"
    else                                  _usage_colour="$fg_green"
    fi

    _usage_bar=""
    _usage_filled=$(( _usage_pct_int > 100 ? 10 : _usage_pct_int * 10 / 100 ))
    for (( i=0; i<_usage_filled; i++ )); do _usage_bar+="█"; done
    for (( i=_usage_filled; i<10; i++ )); do _usage_bar+="░"; done

    # Reset is the next UTC month boundary; the API doesn't return one.
    _usage_reset_month=$(( 10#$(date -u +%m) + 1 ))
    _usage_reset_year=$(date -u +%Y)
    if (( _usage_reset_month > 12 )); then
        _usage_reset_month=1
        (( _usage_reset_year++ ))
    fi
    _usage_reset_epoch=$(date -u -j -f "%Y-%m-%d %H:%M:%S" \
        "$(printf '%04d-%02d-01 00:00:00' "$_usage_reset_year" "$_usage_reset_month")" +%s 2>/dev/null)
    _usage_reset_delta=$(( _usage_reset_epoch - $(date +%s) ))
    if   (( _usage_reset_delta >= 86400 )); then
        _usage_reset_label="$(( _usage_reset_delta / 86400 ))d$(( _usage_reset_delta % 86400 / 3600 ))h"
    elif (( _usage_reset_delta >= 3600 )); then
        _usage_reset_label="$(( _usage_reset_delta / 3600 ))h$(( _usage_reset_delta % 3600 / 60 ))m"
    else
        _usage_reset_label="$(( _usage_reset_delta / 60 ))m"
    fi

    seg_usage="${fg_dim} · ${reset}${_usage_colour}spend ${_usage_bar}${reset} ${fg_dim}${_usage_pct_int}%% (\$${_usage_used_fmt}/\$${_usage_limit_fmt}) ↻${_usage_reset_label}${reset}"
fi

# ── Claude service status (only shown during incidents) ───────────────────────

_cache="$HOME/.cache/claude-statusline.cache"
_cache_ttl=300  # 5 minutes

mkdir -p "$HOME/.cache"

_mtime=$(stat -f %m "$_cache" 2>/dev/null)
if (( $(date +%s) - ${_mtime:-0} > _cache_ttl )); then
    (curl -sf --max-time 5 'https://status.claude.com/history.rss' > "${_cache}.tmp" 2>/dev/null \
        && mv "${_cache}.tmp" "$_cache") &!
fi

seg_service=""
if [[ -f "$_cache" ]]; then
    # Extract first <item> block
    _item=$(awk '/<item>/{f=1} f{print} f && /<\/item>/{exit}' "$_cache")
    # Plain title (no CDATA on this feed)
    _title=$(printf '%s' "$_item" | awk '/<title>/{gsub(/.*<title>/,""); gsub(/<\/title>.*/,""); print; exit}')
    # Most recent status is the first <strong> in the HTML-encoded description
    _status=$(printf '%s' "$_item" | grep -o '&lt;strong&gt;[^&]*&lt;/strong&gt;' | head -1 \
              | sed 's/&lt;strong&gt;//;s/&lt;\/strong&gt;//')
    case "$_status" in
        Investigating|Identified|Monitoring)
            seg_service="${fg_red} ${reset}${fg_yellow}${_title}${reset}"
            ;;
    esac
fi

# ── Vim mode ─────────────────────────────────────────────────────────────────

seg_vim=""
if [[ -n "$vim_mode" ]]; then
    case "$vim_mode" in
        NORMAL)  vim_colour="$fg_green"  ;;
        INSERT)  vim_colour="$fg_cyan"   ;;
        VISUAL*) vim_colour="$fg_purple" ;;
        *)       vim_colour="$fg_yellow" ;;
    esac
    seg_vim="${fg_dim} · ${reset}${vim_colour}${vim_mode}${reset}"
fi

# ── Directory (from $MYPWD, set by _mypwd in 090-prompt.zsh) ─────────────────

# $MYPWD is exported by the interactive shell and uses bookmark-aware truncation.
# Replace the / separators with the arrow style used elsewhere in the prompt.
display_cwd="${MYPWD//\//  }"

# ── Git info ──────────────────────────────────────────────────────────────────

git_info=""
if git_root=$(GIT_OPTIONAL_LOCKS=0 git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
    branch=$(GIT_OPTIONAL_LOCKS=0 git -C "$cwd" symbolic-ref --short HEAD 2>/dev/null \
             || GIT_OPTIONAL_LOCKS=0 git -C "$cwd" rev-parse --short HEAD 2>/dev/null)

    # Porcelain status for staged/unstaged/untracked counts
    status_out=$(GIT_OPTIONAL_LOCKS=0 git -C "$cwd" status --porcelain 2>/dev/null)

    staged=0; modified=0; untracked=0
    while IFS= read -r line; do
        x="${line:0:1}"; y="${line:1:1}"
        [[ "$x" != " " && "$x" != "?" ]] && (( staged++ ))
        [[ "$y" == "M" || "$y" == "D" ]]  && (( modified++ ))
        [[ "$x" == "?" ]]                  && (( untracked++ ))
    done <<< "$status_out"

    # Ahead/behind
    ahead=0; behind=0
    ab=$(GIT_OPTIONAL_LOCKS=0 git -C "$cwd" rev-list --left-right --count \
         HEAD...@{upstream} 2>/dev/null)
    if [[ -n "$ab" ]]; then
        ahead="${ab%%	*}"
        behind="${ab##*	}"
    fi

    git_info=" ${fg_green} ${reset}${fg_green}${branch}${reset}"

    flags=""
    (( staged    > 0 )) && flags+="${fg_yellow}✚${staged}${reset}"
    (( modified  > 0 )) && flags+=" ${fg_red}✽${modified}${reset}"
    (( untracked > 0 )) && flags+=" ${fg_dim}፧${untracked}${reset}"
    (( ahead     > 0 )) && flags+=" ${fg_cyan}${ahead}↑${reset}"
    (( behind    > 0 )) && flags+=" ${fg_yellow}${behind}↓${reset}"

    [[ -n "$flags" ]] && git_info+=" ${fg_dim}[${reset}${flags}${fg_dim}]${reset}"
fi

# ── Assemble the line ─────────────────────────────────────────────────────────

seg_model="${model_colour}${model_icon}${model_short}${reset}"
seg_ctx="${fg_dim}󰾺 ${reset}${context_colour}${context_bar}${reset} ${fg_dim}${context_label}${reset}"
seg_cost="${fg_dim}\$${reset}${fg_white}${cost}${reset}"
seg_dir="${fg_white}󰚝 ${display_cwd}${reset}"

sep="${fg_dim} · ${reset}"

printf "${seg_dir}${git_info}\n"
printf "${seg_model}${sep}${seg_ctx}  ${seg_cost}${seg_usage}${seg_vim}\n"
[[ -n "$seg_service" ]] && printf "${seg_service}\n"
exit 0
