#!/usr/bin/env zsh
# One-time migration of memo files from the old separator format
# (blank / ___ / "timestamp  cwd") to markdown headings with keywords.
# Safe to re-run: already-migrated files are skipped. Delete this script
# once both machines have run it.

local -r DOTKYL_ROOT="${0:A:h:h:h}"   # setup/bin/ is two levels under the repo root
local -r MEMO_DIR="$DOTKYL_ROOT/memo"
local -r WORDS_FILE="$MEMO_DIR/words.txt"
local -r KEYWORD_LENGTH=3              # words per keyword
local -r TIMESTAMP_WIDTH=21            # "YYYY-MM-DD HH:MM:SS" plus two spaces

needs_migration() {
    local file="$1"
    [[ "$(head -1 "$file")" != '# '* ]]
}

# The old format repeated the cwd on every entry; the new one keeps it in
# the H1, taken from the first entry.
memo_cwd() {
    local header="$(sed -n '3p' "$1")"
    print -- "${header[TIMESTAMP_WIDTH+1,-1]}"
}

# Keywords only have to be unique within one file. They come back space
# separated because awk -v chokes on a newline in a value.
keywords_for() {
    local count="$1" keyword
    local -a keywords=()
    while (( ${#keywords} < count )); do
        keyword="$(shuf -n $KEYWORD_LENGTH "$WORDS_FILE" | paste -sd- -)"
        (( ${keywords[(I)$keyword]} )) && continue   # (I) is 0 when absent
        keywords+=("$keyword")
    done
    print -- "${(j: :)keywords}"
}

migrate_file() {
    local file="$1"
    local -i entries="$(ag -U '^___$' "$file" | wc -l)"
    local keywords="$(keywords_for "$entries")"
    # The blank line each old entry started with becomes the one markdown
    # wants above the H2, so only the separator and header lines change.
    local migrated="$(awk -v path="$(memo_cwd "$file")" -v keywords="$keywords" '
        BEGIN { split(keywords, keyword, " "); print "# " path }
        /^___$/ {
            getline header
            print "## " keyword[++n]
            print ""
            print substr(header, 1, 19)
            next
        }
        { print }
    ' "$file")"

    # Bail rather than clobber the notes if the rewrite lost an entry.
    if (( $(ag '^## ' <<< "$migrated" | wc -l) != entries )); then
        print -u2 -- "❌ $file: expected $entries entries, refusing to write"
        return 1
    fi
    print -r -- "$migrated" >| "$file"
}

migrate_or_skip() {
    local file="$1"
    if needs_migration "$file"; then
        migrate_file "$file" && print -- "✅ migrated $file"
    else
        print -- "⏭️  already migrated $file"
    fi
}

main() {
    local -a files=("$MEMO_DIR"/*.md(N))
    if (( ${#files} == 0 )); then
        print -- "⏭️  no memo files"
        return
    fi
    for file in "${files[@]}"; do
        migrate_or_skip "$file"
    done
}

main "$@"
